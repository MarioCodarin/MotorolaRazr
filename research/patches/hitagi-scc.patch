+static void __attribute__((used, noinline)) scc_smn_bringup(void) {
+	volatile u32 *smn;
+	u32 state;
+	u32 i;
+
+	smn = (volatile u32 *) 0x53FAD000u;
+	state = smn[0] & 0x1Fu;
+	if (state == 0x6u) {
+		smn[2] = 0xaaaau;
+		smn[3] = 0x5555u;
+		smn[4] = 0x5555u;
+		for (i = 0; i < 100000u; i++) {
+			state = smn[0] & 0x1Fu;
+			if ((state == 0xAu) || (state == 0xCu)) {
+				break;
+			}
+		}
+	}
+	smn[1] = 0xAu;
+}
