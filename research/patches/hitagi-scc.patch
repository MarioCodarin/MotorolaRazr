+#define SCC_BASE                 0x53FAC000u
+#define SCC_PARAM                0x8001F000u
+#define SCC_RED_OFF              0x500u
+#define SCC_BLACK_OFF            0x900u
+#define SCC_SMN_STATUS           0x400u
+#define SCC_SMN_COMMAND          0x401u
+#define SCC_SMN_SEQ_START        0x402u
+#define SCC_SMN_SEQ_END          0x403u
+#define SCC_SMN_SEQ_CHECK        0x404u
+#define SCC_STATUS_BUSY          0x00000001u
+#define SCC_STATUS_ZEROIZING     0x00000002u
+#define SCC_STATUS_SMN_BLOCKED   0x00000008u
+#define SCC_STATUS_DONE          0x00000400u
+#define SCC_SMN_HEALTH           0x6u
+#define SCC_SMN_STATE_MASK       0x1Fu
+#define SCC_MAX_BYTES            0xC0u
+#define SCC_POLL_LIMIT           2000000u
+
+static void hitagi_command_SCCRUN(const u8 *answer_str, const u8 *data_ptr, const u8 *buffer_next_byte) {
+	volatile u32 *scc;
+	volatile u32 *param;
+	volatile u32 *red;
+	volatile u32 *black;
+	u32 mode;
+	u32 nbytes;
+	u32 nwords;
+	u32 i;
+	u32 t;
+	u32 status;
+	u32 smn;
+
+	UNUSED(answer_str);
+	UNUSED(data_ptr);
+	UNUSED(buffer_next_byte);
+
+	scc = (volatile u32 *) SCC_BASE;
+	param = (volatile u32 *) SCC_PARAM;
+	red = (volatile u32 *) (SCC_BASE + SCC_RED_OFF);
+	black = (volatile u32 *) (SCC_BASE + SCC_BLACK_OFF);
+
+	mode = param[0];
+	nbytes = param[1];
+	if (((mode != 6u) && (mode != 7u)) ||
+	    (nbytes == 0u) || (nbytes > SCC_MAX_BYTES) || ((nbytes & 7u) != 0u)) {
+		hitagi_send_error(ERR_DATA_INVALID);
+		return;
+	}
+
+	for (t = 0; t < SCC_POLL_LIMIT; t++) {
+		status = scc[4];
+		if ((status & (SCC_STATUS_BUSY | SCC_STATUS_ZEROIZING)) == 0u) {
+			break;
+		}
+	}
+
+	smn = scc[SCC_SMN_STATUS] & SCC_SMN_STATE_MASK;
+	if (smn == SCC_SMN_HEALTH) {
+		scc[SCC_SMN_SEQ_START] = 0xaaaau;
+		scc[SCC_SMN_SEQ_END] = 0x5555u;
+		scc[SCC_SMN_SEQ_CHECK] = 0x5555u;
+		smn = scc[SCC_SMN_STATUS] & SCC_SMN_STATE_MASK;
+	}
+	scc[SCC_SMN_COMMAND] = 0xau;
+
+	nwords = nbytes / 4u;
+	scc[0] = 0x20u;
+	scc[1] = 0x20u;
+	scc[8] = param[2];
+	scc[9] = param[3];
+
+	if (mode == 6u) {
+		for (i = 0; i < nwords; i++) {
+			red[i] = param[4u + i];
+		}
+	} else {
+		for (i = 0; i < nwords; i++) {
+			black[i] = param[4u + i];
+		}
+	}
+
+	scc[6] = 0x3u;
+	scc[5] = 0;
+	scc[2] = (nbytes / 8u) - 1u;
+	scc[3] = mode;
+
+	status = 0;
+	for (t = 0; t < SCC_POLL_LIMIT; t++) {
+		status = scc[4];
+		if ((status & SCC_STATUS_DONE) != 0u) {
+			break;
+		}
+		if (((status & SCC_STATUS_BUSY) == 0u) && (t > 1000u)) {
+			break;
+		}
+	}
+
+	if (mode == 6u) {
+		for (i = 0; i < nwords; i++) {
+			param[4u + i] = black[i];
+		}
+	} else {
+		for (i = 0; i < nwords; i++) {
+			param[4u + i] = red[i];
+		}
+	}
+
+	param[0] = status;
+	param[1] = scc[5];
+	param[2] = (t << 8) | smn;
+	param[3] = scc[SCC_SMN_STATUS];
+
+	hitagi_send_ack(NULL);
+}
